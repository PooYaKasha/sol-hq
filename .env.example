# Copy to .env for local runs, or add each line as a Replit Secret. Never commit real values.

# Access. The server refuses to start in production without HQ_PASSWORD.
HQ_USER=matchnice
HQ_PASSWORD=

# Nightly read-only sync (sync/run.js). Each key is read-only; nothing here can move money or write to a system.
STRIPE_READ_KEY=
HUBSPOT_READ_TOKEN=
QUICKBOOKS_READ_TOKEN=
# Google Drive: a service account with drive.metadata.readonly, shared on 00_BRAIN only. Paste the JSON as one secret.
GOOGLE_SERVICE_ACCOUNT_JSON=
DRIVE_BRAIN_FOLDER_ID=10lYoswS5VGaToMdKPrFx4wkQAisT4lj9

# Ask Sol with a model (v1.5). Without it, /api/ask answers from registry/routes.json.
ANTHROPIC_API_KEY=

# Later, once ib approves the matchnice-hq Supabase project (read-only views + RLS). Only the anon key may reach the browser.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Google Chat (docs/google-chat.md). Drafts only until GCHAT_WEBHOOK_URL is set AND GCHAT_SENDING=on (Pooya's go).
# The webhook URL carries a key and token: Replit Secrets only.
GCHAT_WEBHOOK_URL=
GCHAT_SENDING=
GCHAT_PEOPLE=
GCHAT_DIGEST_HOUR=8
GCHAT_DIGEST_AUTOSEND=
HQ_PUBLIC_URL=
